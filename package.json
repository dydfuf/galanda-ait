{
  "name": "galanda",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9"
  },
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev-local.sh",
    "dev:vite": "vite",
    "dev:ait": "bash scripts/dev-local.sh --mode ait",
    "build": "pnpm typecheck && vite build",
    "build:web": "pnpm build",
    "build:ait": "pnpm typecheck && vite build --mode ait && ait build",
    "dev:worker": "pnpm build:web && wrangler dev",
    "dev:staging": "pnpm build:web && wrangler dev --remote --env staging",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "types:worker": "wrangler types --env-file=wrangler-types.env",
    "typecheck": "wrangler types --check --env-file=wrangler-types.env && tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:seed": "node scripts/seed-e2e-auth.ts",
    "eval:nba": "node scripts/run-trip-action-ranking-eval.ts",
    "db:setup:local": "bash scripts/setup-local-db.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.dev.vars ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "drizzle-kit check",
    "check:db": "pnpm db:check && bash scripts/check-drizzle-drift.sh",
    "check": "pnpm lint && pnpm test && pnpm check:db && pnpm build && pnpm build:ait",
    "preview": "vite preview",
    "deploy": "ait deploy",
    "deploy:staging": "pnpm build:web && wrangler deploy --env staging"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.0.3",
    "@base-ui/react": "1.7.0",
    "@better-auth/drizzle-adapter": "1.7.1",
    "@emotion/react": "11.14.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "better-auth": "1.7.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-rc.109",
    "hono": "4.13.3",
    "lucide-react": "1.33.0",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "shadcn": "4.18.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "3.0.3",
    "@better-auth/memory-adapter": "1.7.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.4",
    "drizzle-kit": "0.31.10",
    "jsdom": "^30.0.1",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-window": "7.4.1",
    "wrangler": "4.125.0"
  }
}
