{
  "name": "galanda",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ait": "vite --mode ait",
    "build": "npm run typecheck && vite build",
    "build:web": "npm run build",
    "build:ait": "npm run typecheck && vite build --mode ait && ait build",
    "dev:worker": "npm run build:web && wrangler dev",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "types:worker": "wrangler types",
    "typecheck": "wrangler types --check && tsc -b --pretty false",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "check:db": "npm run db:check && bash scripts/check-drizzle-drift.sh",
    "check": "npm run lint && npm test && npm run check:db && npm run build && npm run build:ait",
    "preview": "vite preview",
    "deploy": "ait deploy",
    "deploy:staging": "npm run build:web && wrangler deploy --env staging"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.0.3",
    "@base-ui/react": "1.7.0",
    "@better-auth/drizzle-adapter": "1.7.1",
    "@emotion/react": "11.14.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "better-auth": "1.7.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-rc.109",
    "hono": "4.13.3",
    "lucide-react": "1.33.0",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "shadcn": "4.18.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "3.0.3",
    "@better-auth/memory-adapter": "1.7.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.4",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
