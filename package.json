{
  "name": "galanda",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ait": "vite --mode ait",
    "build": "tsc -b && vite build",
    "build:web": "npm run build",
    "build:ait": "tsc -b && vite build --mode ait && ait build",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build && npm run build:ait",
    "preview": "vite preview",
    "deploy": "ait deploy"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.0.3",
    "@base-ui/react": "^1.7.0",
    "@emotion/react": "^11.14.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-rc.109",
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "^3.0.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "~7.0.2001",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
